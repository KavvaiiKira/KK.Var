<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KK.Var.ViewModels"
             xmlns:models="using:KK.Var.Models"
             xmlns:controls="using:KK.Var.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="800"
             x:Class="KK.Var.Views.Pages.CreateProjectView"
             x:DataType="vm:CreateProjectViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.project-field">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox.project-field">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="NumericUpDown.project-field">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.project-primary">
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.project-secondary">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  Margin="30,24,30,18"
                  ColumnDefinitions="Auto,*,Auto">
                <Button Width="42"
                        Height="42"
                        Margin="0,0,14,0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Classes="project-secondary"
                        Click="BackButton_OnClick"
                        ToolTip.Tip="{DynamicResource BackProjects}">
                    <PathIcon Width="19"
                              Height="19"
                              Data="M20,11H7.8L13.4,5.4L12,4L4,12L12,20L13.4,18.6L7.8,13H20V11Z" />
                </Button>

                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding EditorTitle}"
                               FontSize="30"
                               FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource SourceBuildDeploymentSettings}"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                    <Button Classes="project-primary"
                            IsEnabled="{Binding !IsSaving}"
                            Content="{Binding SaveButtonText}"
                            Click="SaveButton_OnClick" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="30,0,20,24"
                          HorizontalContentAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1050"
                            HorizontalAlignment="Stretch"
                            Spacing="18">
                    <Border Padding="24" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{DynamicResource ProjectMachine}" FontSize="19" FontWeight="Bold" />
                            <ComboBox ItemsSource="{Binding ProjectMachines}" SelectedItem="{Binding SelectedProjectMachine}"
                                      HorizontalAlignment="Stretch" Classes="project-field">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:RemoteMachine">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel IsVisible="{Binding IsProjectMachineChanged}" Spacing="8">
                                <TextBlock Text="{DynamicResource NewDeployRollbackOperationsUseSelectedMachine}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}" />
                                <CheckBox IsChecked="{Binding MachineSwitchConfirmed}" Content="{DynamicResource IConfirmMachineChange}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                            <StackPanel Spacing="7">
                                <TextBlock Classes="field-label" Text="{DynamicResource ProjectName}" />
                                <TextBox Classes="project-field"
                                         Text="{Binding Name, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource ExampleBillingAPI}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Classes="field-label" Text="{DynamicResource Common_Description}" />
                                <TextBox Classes="project-field"
                                         Text="{Binding Description, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource OptionalProjectNameUsedDefault}" />
                            </StackPanel>

                        </Grid>
                    </Border>

                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource VersionStorage}"
                                           FontSize="19"
                                           FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource LimitsAppliedDuringAutomaticCleanupSuccessfulDeploy}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="field-label"
                                               Text="{DynamicResource MaximumVersionCount}" />
                                    <NumericUpDown Classes="project-field"
                                                   Minimum="1"
                                                   Maximum="10000"
                                                   Increment="1"
                                                   Value="{Binding MaxStoredVersions, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="7">
                                    <TextBlock Classes="field-label"
                                               Text="{DynamicResource SizeLimitMB}" />
                                    <TextBox Classes="project-field"
                                             Text="{Binding MaxStoredVersionSizeMb, Mode=TwoWay}"
                                             PlaceholderText="{DynamicResource Unlimited}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Source_Title}"
                                           FontSize="19"
                                           FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource KKVarBuildProjectSelectedSource}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Classes="field-label" Text="{DynamicResource SourceType}" />
                                <ComboBox Classes="project-field"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding SourceTypes}"
                                          SelectedValue="{Binding SelectedSourceType, Mode=TwoWay}"
                                          SelectedValueBinding="{CompiledBinding Value, DataType={x:Type models:EnumOption}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EnumOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Grid IsVisible="{Binding IsLocalSource}"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="field-label" Text="{DynamicResource ProjectFolder}" />
                                    <TextBox Classes="project-field"
                                             Text="{Binding LocalDirectoryPath, Mode=TwoWay}"
                                             PlaceholderText="{DynamicResource SelectFolderComputer}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="0,23,0,0"
                                        Classes="project-secondary"
                                        Content="{DynamicResource Browse}"
                                        Click="BrowseFolderButton_OnClick" />
                            </Grid>

                            <Grid IsVisible="{Binding IsGitHubSource}"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="field-label" Text="{DynamicResource GitHubRepository}" />
                                    <ComboBox Classes="project-field"
                                              ItemsSource="{Binding GitHubRepositories}"
                                              SelectedItem="{Binding SelectedGitHubRepository, Mode=TwoWay}"
                                              PlaceholderText="{DynamicResource SelectRepository}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:GitHubRepository">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding FullName}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="16,0,0,0"
                                                               Text="{DynamicResource Private}"
                                                               IsVisible="{Binding IsPrivate}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppTextMutedBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="0,23,0,0"
                                        Classes="project-secondary"
                                        IsEnabled="{Binding !IsLoadingRepositories}"
                                        Content="{DynamicResource Refresh}"
                                        Command="{Binding RefreshGitHubRepositoriesCommand}" />
                            </Grid>
                                <StackPanel IsVisible="{Binding IsGitHubSource}" Spacing="8">
                                    <TextBlock Text="{DynamicResource ProjectGitHubBranch}" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <ComboBox
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding GitHubBranchSelection.Branches}"
                                              SelectedItem="{Binding GitHubBranchSelection.SelectedBranch, Mode=TwoWay}"
                                              DropDownOpened="ProjectBranches_OnOpened">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:GitHubBranchOption">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button
                                            Classes="project-secondary" HorizontalAlignment="Left"
                                            Content="{DynamicResource RefreshCommit}" Click="ProjectCommit_OnClick" />
                                    <TextBlock IsVisible="{Binding GitHubBranchSelection.IsLoadingBranches}" Text="{DynamicResource LoadingBranches}" />
                                    <TextBlock IsVisible="{Binding GitHubBranchSelection.IsResolving}" Text="{DynamicResource LoadingCommit}" />
                                    <TextBlock IsVisible="{Binding GitHubBranchSelection.HasError}" Text="{Binding GitHubBranchSelection.ErrorMessage}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}" />
                                    <controls:GitHubCommitCard DataContext="{Binding GitHubBranchSelection}" />
                                </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto,Auto,Auto">
                            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16" Spacing="5">
                                <TextBlock Text="{DynamicResource BuildRun}"
                                           FontSize="19"
                                           FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource AutomaticDetectionCanOverriddenManually}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="7">
                                <TextBlock Classes="field-label" Text="{DynamicResource ProjectType}" />
                                <ComboBox Classes="project-field"
                                          ItemsSource="{Binding BuildProviders}"
                                          SelectedValue="{Binding SelectedBuildProvider, Mode=TwoWay}"
                                          SelectedValueBinding="{CompiledBinding Value, DataType={x:Type models:EnumOption}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EnumOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="7" IsVisible="{Binding !IsPythonBuild}">
                                <TextBlock Classes="field-label" Text="{DynamicResource ExecutableFileEntryPoint}" />
                                <TextBox Classes="project-field"
                                         Text="{Binding RemoteExecutableFileName, Mode=TwoWay}"
                                         PlaceholderText="app.dll, main.py, server" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,18,0,0" Spacing="7">
                                <TextBlock Classes="field-label" Text="{DynamicResource SystemdServiceName}" />
                                <TextBox Classes="project-field"
                                         Text="{Binding RemoteServiceName, Mode=TwoWay}"
                                         PlaceholderText="billing-api.service" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,18,0,0" Spacing="7">
                                <TextBlock Classes="field-label" Text="{DynamicResource RemoteMachineDirectory}" />
                                <TextBox Classes="project-field"
                                         Text="{Binding RemoteDeploymentDirectory, Mode=TwoWay}"
                                         PlaceholderText="/opt/kk-var/billing-api" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,18,0,0" Spacing="12">
                                <Button Classes="project-secondary" HorizontalAlignment="Left"
                                        Content="{DynamicResource DetectBuildSettings}"
                                        Command="{Binding DetectBuildSettingsCommand}" />
                                <TextBlock Text="{DynamicResource PathsRelativeWorkingDirectoryEmptyPythonDependency}"
                                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                                <TextBlock IsVisible="{Binding IsAutomaticBuild}"
                                           Text="{DynamicResource SelectBuildTypeDetectLocalDirectoryConfigure}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" />
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="field-label" Text="{DynamicResource Build_WorkingDirectory}" />
                                    <TextBox Classes="project-field" Text="{Binding BuildWorkingDirectory, Mode=TwoWay}" PlaceholderText="." />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsDotNetBuild}" Spacing="12">
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="field-label" Text="{DynamicResource ProjectSolutionNET}" />
                                        <TextBox Classes="project-field" Text="{Binding DotNetProjectPath, Mode=TwoWay}" PlaceholderText="{DynamicResource AutomaticCsprojSelection}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding HasBuildConfiguration}" Spacing="12">
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="field-label" Text="{DynamicResource BuildConfiguration}" />
                                        <TextBox Classes="project-field" Text="{Binding BuildConfiguration, Mode=TwoWay}" PlaceholderText="Release" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsGoBuild}" Spacing="12">
                                    <CheckBox IsChecked="{Binding CgoEnabled, Mode=TwoWay}" Content="{DynamicResource EnableCGO}" />
                                    <TextBlock Text="{DynamicResource CGORequiresCCompilerTargetingLinuxArchitecture}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsPythonBuild}" Spacing="12">
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="field-label" Text="{DynamicResource PythonEntryPoint}" />
                                        <TextBox Classes="project-field" Text="{Binding RemoteExecutableFileName, Mode=TwoWay}" PlaceholderText="main.py" />
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="field-label" Text="{DynamicResource PythonDependencyFile}" />
                                        <TextBox Classes="project-field" Text="{Binding PythonDependencyFilePath, Mode=TwoWay}" PlaceholderText="requirements.txt / pyproject.toml" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsCppBuild}" Spacing="12">
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="field-label" Text="{DynamicResource CMakeGenerator}" />
                                        <TextBox Classes="project-field" Text="{Binding CmakeGenerator, Mode=TwoWay}" PlaceholderText="Ninja" />
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="field-label" Text="{DynamicResource ToolchainFile}" />
                                        <TextBox Classes="project-field" Text="{Binding ToolchainFile, Mode=TwoWay}" PlaceholderText="toolchains/linux-{architecture}.cmake" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsCustomBuild}" Spacing="12">
                                    <StackPanel Spacing="7">
                                        <TextBlock Classes="field-label" Text="{DynamicResource BuildCommand}" />
                                        <TextBox Classes="project-field" Text="{Binding CustomBuildCommand, Mode=TwoWay}" PlaceholderText="dotnet / cmd.exe / build.cmd" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsCppBuild}" Spacing="7">
                                    <TextBlock Classes="field-label" Text="{DynamicResource CMakeConfigureArguments}" />
                                    <TextBox Classes="project-field" MinHeight="80" Padding="12,10"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                             Text="{Binding ConfigureArgumentsText, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding !IsPythonBuild}" Spacing="7">
                                    <TextBlock Classes="field-label" Text="{DynamicResource AdditionalBuildArguments}" />
                                    <TextBox Classes="project-field" MinHeight="80" Padding="12,10"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                             Text="{Binding BuildArgumentsText, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsPythonBuild}" Spacing="7">
                                    <TextBlock Classes="field-label" Text="{DynamicResource PipInstallArguments}" />
                                    <TextBox Classes="project-field" MinHeight="80" Padding="12,10"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                             Text="{Binding BuildArgumentsText, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel IsVisible="{Binding !IsPythonBuild}" Spacing="7">
                                    <TextBlock Classes="field-label" Text="{DynamicResource BuildProcessEnvironment}" />
                                    <TextBox Classes="project-field" MinHeight="80" Padding="12,10"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                             Text="{Binding BuildEnvironmentText, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource OneArgumentPerLineEnvironmentNAMEValue}"
                                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{DynamicResource EnvironmentVariables}"
                                       FontSize="19"
                                       FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource PathRelativeProjectRootKKVarCreates}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                            <TextBox Margin="0,8,0,0"
                                     Classes="project-field"
                                     Text="{Binding ProjectEnvironmentFilePath, Mode=TwoWay}"
                                     PlaceholderText="config/production.env.json" />
                        </StackPanel>
                    </Border>

                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource HealthCheck}"
                                           FontSize="19"
                                           FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource OptionalCheckRunsSystemdServiceStarts}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Classes="field-label"
                                           Text="{DynamicResource HealthCheckType}" />
                                <ComboBox Classes="project-field"
                                          ItemsSource="{Binding HealthCheckTypes}"
                                          SelectedValue="{Binding SelectedHealthCheckType, Mode=TwoWay}"
                                          SelectedValueBinding="{CompiledBinding Value, DataType={x:Type models:EnumOption}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EnumOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsStabilityDelayHealthCheck}"
                                        Spacing="7">
                                <TextBlock Classes="field-label"
                                           Text="{DynamicResource StableOperationTimeSeconds}" />
                                <NumericUpDown Classes="project-field"
                                               Minimum="1"
                                               Maximum="3600"
                                               Increment="1"
                                               Value="{Binding HealthCheckStabilityDelaySeconds, Mode=TwoWay}" />
                            </StackPanel>

                            <Grid IsVisible="{Binding HasHealthCheckRetrySettings}"
                                  ColumnDefinitions="*,*,*"
                                  ColumnSpacing="18">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="field-label"
                                               Text="{DynamicResource TimeoutSeconds}" />
                                    <NumericUpDown Classes="project-field"
                                                   Minimum="1"
                                                   Maximum="3600"
                                                   Increment="1"
                                                   Value="{Binding HealthCheckTimeoutSeconds, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="7">
                                    <TextBlock Classes="field-label"
                                               Text="{DynamicResource IntervalSeconds}" />
                                    <NumericUpDown Classes="project-field"
                                                   Minimum="1"
                                                   Maximum="3600"
                                                   Increment="1"
                                                   Value="{Binding HealthCheckIntervalSeconds, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="7">
                                    <TextBlock Classes="field-label"
                                               Text="{DynamicResource NumberAttempts}" />
                                    <NumericUpDown Classes="project-field"
                                                   Minimum="1"
                                                   Maximum="100"
                                                   Increment="1"
                                                   Value="{Binding HealthCheckAttempts, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel IsVisible="{Binding IsHttpHealthCheck}"
                                        Spacing="7">
                                <TextBlock Classes="field-label"
                                           Text="{DynamicResource HTTPAddress}" />
                                <TextBox Classes="project-field"
                                         Text="{Binding HealthCheckHttpUrl, Mode=TwoWay}"
                                         PlaceholderText="http://127.0.0.1:8080/health" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsTcpHealthCheck}"
                                        Spacing="7">
                                <TextBlock Classes="field-label"
                                           Text="{DynamicResource TCPPort}" />
                                <NumericUpDown Classes="project-field"
                                               Minimum="1"
                                               Maximum="65535"
                                               Increment="1"
                                               Value="{Binding HealthCheckTcpPort, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsCommandHealthCheck}"
                                        Spacing="7">
                                <TextBlock Classes="field-label"
                                           Text="{DynamicResource CommandRemoteMachine}" />
                                <TextBox Classes="project-field"
                                         Text="{Binding HealthCheckCommand, Mode=TwoWay}"
                                         PlaceholderText="curl --fail http://127.0.0.1:8080/health" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="DiscardConfirmation"
                IsVisible="False"
                Background="#C9080510">
            <Border Width="460"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource DiscardChanges}"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource EnteredProjectDataLost}"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <StackPanel Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Classes="project-secondary"
                                Content="{DynamicResource ContinueEditing}"
                                Click="ContinueEditingButton_OnClick" />
                        <Button Classes="project-primary"
                                Content="{DynamicResource Discard}"
                                Click="DiscardButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
