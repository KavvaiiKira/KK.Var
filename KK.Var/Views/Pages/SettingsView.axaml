<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KK.Var.ViewModels"
             xmlns:models="using:KK.Var.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="800"
             x:Class="KK.Var.Views.Pages.SettingsView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.settings-field">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox.settings-field">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.settings-primary">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.settings-secondary">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              Margin="30,26,30,18"
              ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
                <TextBlock Text="{DynamicResource 'Настройки'}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="{DynamicResource 'GitHub, локальные версии и подключение к Linux-машине'}"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextMutedBrush}" />
            </StackPanel>

        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="30,0,20,24"
                      HorizontalContentAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1050"
                        HorizontalAlignment="Stretch"
                        Spacing="18">
                <Border Padding="24"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel Spacing="20">
                        <TextBlock Text="{DynamicResource 'Профили удалённых машин'}" FontSize="19" FontWeight="Bold" />
                        <ComboBox Classes="settings-field" IsVisible="{Binding !!MachineEditor.MachineProfiles.Count}" ItemsSource="{Binding MachineEditor.MachineProfiles}" SelectedItem="{Binding MachineEditor.SelectedMachineProfile}"
                                  IsEnabled="{Binding !MachineEditor.IsConnectionCheckRunning}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RemoteMachine">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock IsVisible="{Binding IsArchived}" Text="{DynamicResource 'Архив'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <WrapPanel ItemSpacing="10" LineSpacing="8">
                            <Button Classes="settings-secondary" Content="{DynamicResource 'Добавить профиль'}" IsEnabled="{Binding !MachineEditor.IsConnectionCheckRunning}" Command="{Binding MachineEditor.AddMachineProfileCommand}" Click="AddMachineProfileButton_OnClick" />
                            <Button Classes="settings-secondary" IsVisible="{Binding !!MachineEditor.SelectedMachineProfile}" Content="{Binding MachineEditor.ArchiveMachineCaption}" Command="{Binding MachineEditor.ArchiveMachineProfileCommand}" />
                        </WrapPanel>
                        <TextBlock IsVisible="{Binding MachineEditor.IsNewMachineProfile}"
                                   Text="{DynamicResource 'Новый профиль'}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                        <TextBlock Text="{DynamicResource 'Укажите имя, заполните SSH-подключение ниже и нажмите «Проверить и сохранить профиль». При первом подключении сверьте и подтвердите fingerprint сервера.'}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock Text="{DynamicResource 'Имя профиля машины'}" />
                        <TextBox x:Name="MachineProfileNameInput" Classes="settings-field" Text="{Binding MachineEditor.MachineProfileName, Mode=TwoWay}" IsEnabled="{Binding !MachineEditor.IsConnectionCheckRunning}" />
                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" />
                        <StackPanel Spacing="5">
                            <TextBlock Text="{DynamicResource 'Настройки подключения'}"
                                       FontSize="19"
                                       FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource 'Параметры выбранного профиля. Адрес сохраняется только после проверки и подтверждения.'}"
                                       FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>

                        <Border IsVisible="{Binding AppSettings.IsFirstRunSetupRequired}"
                                Padding="14"
                                Background="#2A172A"
                                BorderBrush="{DynamicResource AppDangerBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource 'Завершите обязательную настройку'}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppDangerBrush}" />
                                <TextBlock Text="{DynamicResource 'Заполните отмеченные поля подключения к удалённой машине и сохраните настройки.'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" />

                        <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,18,Auto,18,Auto" IsEnabled="{Binding !MachineEditor.IsConnectionCheckRunning}">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource 'Адрес или IP'}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text=" *" IsVisible="{Binding AppSettings.IsFirstRunSetupRequired}" FontSize="12" Foreground="{DynamicResource AppDangerBrush}" />
                                </StackPanel>
                                <TextBox Classes="settings-field"
                                         PlaceholderText="server.example.com"
                                         Text="{Binding MachineEditor.MachineConnection.Host, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource 'SSH-порт'}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text=" *" IsVisible="{Binding AppSettings.IsFirstRunSetupRequired}" FontSize="12" Foreground="{DynamicResource AppDangerBrush}" />
                                </StackPanel>
                                <TextBox Classes="settings-field"
                                         PlaceholderText="22"
                                         Text="{Binding MachineEditor.MachineConnection.Port, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource 'Пользователь'}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text=" *" IsVisible="{Binding AppSettings.IsFirstRunSetupRequired}" FontSize="12" Foreground="{DynamicResource AppDangerBrush}" />
                                </StackPanel>
                                <TextBox Classes="settings-field"
                                         PlaceholderText="deploy"
                                         Text="{Binding MachineEditor.MachineConnection.UserName, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource 'Способ входа'}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text=" *" IsVisible="{Binding AppSettings.IsFirstRunSetupRequired}" FontSize="12" Foreground="{DynamicResource AppDangerBrush}" />
                                </StackPanel>
                                <ComboBox Classes="settings-field"
                                          ItemsSource="{Binding MachineEditor.AuthenticationMethods}"
                                          SelectedValue="{Binding MachineEditor.AuthenticationMethod, Mode=TwoWay}"
                                          SelectedValueBinding="{CompiledBinding Value, DataType={x:Type models:EnumOption}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EnumOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource 'Путь к приватному SSH-ключу'}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text=" *" IsVisible="{Binding AppSettings.IsFirstRunSetupRequired}" FontSize="12" Foreground="{DynamicResource AppDangerBrush}" />
                                </StackPanel>
                                <TextBox Classes="settings-field"
                                         PlaceholderText="C:\Users\user\.ssh\id_ed25519"
                                         IsEnabled="{Binding MachineEditor.IsPrivateKeyAuthentication}"
                                         Text="{Binding MachineEditor.MachineConnection.PrivateKeyPath, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource 'Пароль'}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text=" *" IsVisible="{Binding AppSettings.IsFirstRunSetupRequired}" FontSize="12" Foreground="{DynamicResource AppDangerBrush}" />
                                </StackPanel>
                                <TextBox Classes="settings-field"
                                         PasswordChar="●"
                                         IsEnabled="{Binding MachineEditor.IsPasswordAuthentication}"
                                         Text="{Binding MachineEditor.MachineConnection.Password, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Border Padding="14"
                                Background="{DynamicResource AppSurfaceRaisedBrush}"
                                CornerRadius="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,20,0"
                                            VerticalAlignment="Center"
                                            Spacing="5">
                                    <TextBlock Text="{DynamicResource 'Архитектура удалённой машины'}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MachineEditor.RemoteMachineArchitecture}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppTextMutedBrush}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Classes="settings-primary"
                                        Content="{DynamicResource 'Проверить и сохранить профиль'}"
                                        IsEnabled="{Binding !MachineEditor.IsConnectionCheckRunning}"
                                        Command="{Binding CheckRemoteConnectionCommand}" />
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding MachineEditor.IsHostKeyConfirmationRequired}"
                                Padding="14"
                                Background="#241A3A"
                                BorderBrush="{DynamicResource AppPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{DynamicResource 'Подтвердите SSH-сервер'}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource 'Сверьте отпечаток с данными администратора удалённой машины.'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text="{Binding MachineEditor.MachineIdentityMessage}"
                                               FontSize="12"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap" />
                                    <TextBlock IsVisible="{Binding MachineEditor.HasMachineIdentityWarning}"
                                               Text="{DynamicResource 'Fingerprint отличается или ещё не подтверждён. Возможна переустановка, замена SSH-ключей или другой сервер.'}"
                                               TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AppDangerBrush}" />
                                    <TextBlock IsVisible="{Binding MachineEditor.IsMachineFingerprintMatch}"
                                               Text="{DynamicResource 'Fingerprint совпадает: это сильное подтверждение идентичности машины. Подтвердите выбор.'}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource AppSuccessBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical"
                                            IsEnabled="{Binding !MachineEditor.IsConnectionCheckRunning}"
                                            Spacing="8">
                                    <Button Classes="settings-secondary"
                                            Content="{DynamicResource 'Отмена'}"
                                            Command="{Binding CancelHostKeyConfirmationCommand}" />
                                    <Button Classes="settings-primary"
                                            Content="{Binding MachineEditor.ConfirmMachineIdentityCaption}"
                                            Command="{Binding ConfirmHostKeyCommand}" />
                                    <Button Classes="settings-secondary" Content="{DynamicResource 'Нет, создать новую'}"
                                            Command="{Binding MachineEditor.CreateNewMachineFromCandidateCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource 'Проекты этого профиля'}"
                                       FontSize="19"
                                       FontWeight="Bold" />
                            <TextBlock IsVisible="{Binding !!MachineEditor.MachineProjectsDisplay}"
                                       Text="{Binding MachineEditor.MachineProjectsDisplay}"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding !MachineEditor.MachineProjectsDisplay}"
                                       Text="{DynamicResource 'К этому профилю пока не привязаны проекты.'}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="24"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="5">
                                <TextBlock Text="GitHub"
                                           FontSize="19"
                                           FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource 'Доступ к списку ваших репозиториев через GitHub Device Flow'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    IsVisible="{Binding !GitHubAccount.IsGitHubConnected}"
                                    Padding="10,5"
                                    Background="{DynamicResource AppSurfaceHoverBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource 'Не подключён'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </Border>

                            <Border Grid.Column="1"
                                    IsVisible="{Binding GitHubAccount.IsGitHubConnected}"
                                    Padding="10,5"
                                    Background="#223F2E"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource 'Подключён'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppSuccessBrush}" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Height="1"
                                Margin="0,20"
                                Background="{DynamicResource AppBorderBrush}" />

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource 'Аккаунт'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                                <TextBlock Text="{Binding GitHubAccount.GitHubAccountDisplay}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    IsVisible="{Binding !GitHubAccount.IsGitHubConnected}"
                                    Classes="settings-secondary"
                                    Content="{DynamicResource 'Подключить GitHub'}"
                                    Command="{Binding GitHubAccount.ConnectGitHubCommand}" />

                            <StackPanel Grid.Column="1"
                                        IsVisible="{Binding GitHubAccount.IsGitHubConnected}"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <Button Classes="settings-secondary"
                                        Content="{DynamicResource 'Отключить'}"
                                        Command="{Binding GitHubAccount.DisconnectGitHubCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                IsVisible="{Binding GitHubAccount.IsGitHubAuthorizationPending}"
                                Margin="0,18,0,0"
                                Padding="16"
                                Background="{DynamicResource AppSurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource 'Подтвердите вход в GitHub'}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GitHubAccount.GitHubConnectionStatus}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text="{Binding GitHubAccount.GitHubUserCode}"
                                               Margin="0,5,0,0"
                                               FontFamily="Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Classes="settings-secondary"
                                            Content="{DynamicResource 'Копировать код'}"
                                            Click="CopyGitHubCodeButton_OnClick" />
                                    <Button Classes="settings-secondary"
                                            Content="{DynamicResource 'Открыть GitHub'}"
                                            Command="{Binding GitHubAccount.OpenGitHubVerificationPageCommand}" />
                                    <Button Classes="settings-secondary"
                                            Content="{DynamicResource 'Отмена'}"
                                            Command="{Binding GitHubAccount.CancelGitHubAuthorizationCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="4"
                                   IsVisible="{Binding !GitHubAccount.IsGitHubAuthorizationPending}"
                                   Margin="0,12,0,0"
                                   Text="{Binding GitHubAccount.GitHubConnectionStatus}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                    </Grid>
                </Border>

                <Border Padding="24" Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource 'Уведомления Windows'}" FontSize="19" FontWeight="Bold" />
                        <CheckBox Content="{DynamicResource 'Уведомлять о завершении Deploy и rollback'}"
                                  IsChecked="{Binding AppSettings.DeploymentNotificationsEnabled, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource 'Показывать краткий результат, когда окно свёрнуто или открыта другая страница. Настройка сохраняется сразу.'}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Padding="24"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{DynamicResource 'Локальные версии'}"
                                       FontSize="19"
                                       FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource 'Каталог содержит архивы версий всех проектов.'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource 'Эффективный путь'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                                <TextBlock Text="{Binding ArtifactStorage.ArtifactStorageEffectivePath}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}">
                                    <Run Text="{DynamicResource 'Занято архивами'}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding ArtifactStorage.ArtifactStorageUsedDisplay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Classes="settings-secondary"
                                        IsEnabled="{Binding !ArtifactStorage.IsArtifactStorageBusy}"
                                        Content="{DynamicResource 'Выбрать папку'}"
                                        Click="SelectArtifactsDirectoryButton_OnClick" />
                                <Button Classes="settings-secondary"
                                        IsEnabled="{Binding !ArtifactStorage.IsArtifactStorageBusy}"
                                        Content="{DynamicResource 'По умолчанию'}"
                                        Click="ResetArtifactsDirectoryButton_OnClick" />
                            </StackPanel>
                        </Grid>

                        <Border IsVisible="{Binding ArtifactStorage.HasPendingArtifactStorageMigration}"
                                Padding="16"
                                Background="{DynamicResource AppSurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource AppPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource 'План переноса архивов'}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ArtifactStorage.PendingArtifactStorageMigration.SourceRoot, StringFormat='{}{0} →'}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <TextBlock Text="{Binding ArtifactStorage.PendingArtifactStorageMigration.TargetRoot}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Text="{Binding ArtifactStorage.ArtifactStorageMigrationFileCountDisplay}" />
                                        <TextBlock Text="{Binding ArtifactStorage.ArtifactStorageMigrationSizeDisplay}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Classes="settings-secondary"
                                            IsEnabled="{Binding !ArtifactStorage.IsArtifactStorageBusy}"
                                            Content="{DynamicResource 'Отмена'}"
                                            Click="CancelArtifactMigrationButton_OnClick" />
                                    <Button Classes="settings-primary"
                                            IsEnabled="{Binding !ArtifactStorage.IsArtifactStorageBusy}"
                                            Content="{DynamicResource 'Перенести'}"
                                            Click="ApplyArtifactMigrationButton_OnClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock IsVisible="{Binding !!ArtifactStorage.ArtifactStorageWarning}"
                                   Text="{Binding ArtifactStorage.ArtifactStorageWarning}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppDangerBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
