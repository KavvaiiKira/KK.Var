<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KK.Var.ViewModels"
             xmlns:models="using:KK.Var.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="800"
             x:Class="KK.Var.Views.Pages.CreateProjectView"
             x:DataType="vm:CreateProjectViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.project-field">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox.project-field">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.project-primary">
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.project-secondary">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  Margin="30,24,30,18"
                  ColumnDefinitions="Auto,*,Auto">
                <Button Width="42"
                        Height="42"
                        Margin="0,0,14,0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Classes="project-secondary"
                        Click="BackButton_OnClick"
                        ToolTip.Tip="Назад к проектам">
                    <PathIcon Width="19"
                              Height="19"
                              Data="M20,11H7.8L13.4,5.4L12,4L4,12L12,20L13.4,18.6L7.8,13H20V11Z" />
                </Button>

                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding EditorTitle}"
                               FontSize="30"
                               FontWeight="Bold" />
                    <TextBlock Text="Источник, сборка и параметры развёртывания"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                    <Button Classes="project-primary"
                            IsEnabled="{Binding !IsSaving}"
                            Content="{Binding SaveButtonText}"
                            Click="SaveButton_OnClick" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="30,0,20,24"
                          HorizontalContentAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1050"
                            HorizontalAlignment="Stretch"
                            Spacing="18">
                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto">
                            <StackPanel Spacing="7">
                                <TextBlock Classes="field-label" Text="Название проекта" />
                                <TextBox Classes="project-field"
                                         Text="{Binding Name, Mode=TwoWay}"
                                         PlaceholderText="Например, Billing API" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Classes="field-label" Text="Описание" />
                                <TextBox Classes="project-field"
                                         Text="{Binding Description, Mode=TwoWay}"
                                         PlaceholderText="Необязательно — иначе используется название" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,18,0,0"
                                        Spacing="7">
                                <TextBlock Classes="field-label" Text="Способ получения исходников" />
                                <ComboBox Classes="project-field"
                                          ItemsSource="{Binding SourceTypes}"
                                          SelectedItem="{Binding SelectedSourceType, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Исходный код"
                                           FontSize="19"
                                           FontWeight="Bold" />
                                <TextBlock Text="KK.Var будет собирать проект из выбранного источника"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>

                            <Grid IsVisible="{Binding IsLocalSource}"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="field-label" Text="Папка проекта" />
                                    <TextBox Classes="project-field"
                                             Text="{Binding LocalDirectoryPath, Mode=TwoWay}"
                                             PlaceholderText="Выберите папку на этом компьютере" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="0,23,0,0"
                                        Classes="project-secondary"
                                        Content="Обзор..."
                                        Click="BrowseFolderButton_OnClick" />
                            </Grid>

                            <Grid IsVisible="{Binding IsGitHubSource}"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <StackPanel Spacing="7">
                                    <TextBlock Classes="field-label" Text="Репозиторий GitHub" />
                                    <ComboBox Classes="project-field"
                                              ItemsSource="{Binding GitHubRepositories}"
                                              SelectedItem="{Binding SelectedGitHubRepository, Mode=TwoWay}"
                                              PlaceholderText="Выберите репозиторий">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:GitHubRepository">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding FullName}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="16,0,0,0"
                                                               Text="private"
                                                               IsVisible="{Binding IsPrivate}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppTextMutedBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="0,23,0,0"
                                        Classes="project-secondary"
                                        IsEnabled="{Binding !IsLoadingRepositories}"
                                        Content="Обновить"
                                        Command="{Binding RefreshGitHubRepositoriesCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto,Auto">
                            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16" Spacing="5">
                                <TextBlock Text="Сборка и запуск"
                                           FontSize="19"
                                           FontWeight="Bold" />
                                <TextBlock Text="Автоопределение можно уточнить вручную"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="7">
                                <TextBlock Classes="field-label" Text="Тип проекта" />
                                <ComboBox Classes="project-field"
                                          ItemsSource="{Binding BuildProviders}"
                                          SelectedItem="{Binding SelectedBuildProvider, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="7">
                                <TextBlock Classes="field-label" Text="Исполняемый файл или точка входа" />
                                <TextBox Classes="project-field"
                                         Text="{Binding RemoteExecutableFileName, Mode=TwoWay}"
                                         PlaceholderText="app.dll, main.py, server" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,18,0,0" Spacing="7">
                                <TextBlock Classes="field-label" Text="Название systemd-сервиса" />
                                <TextBox Classes="project-field"
                                         Text="{Binding RemoteServiceName, Mode=TwoWay}"
                                         PlaceholderText="billing-api.service" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,18,0,0" Spacing="7">
                                <TextBlock Classes="field-label" Text="Директория на удалённой машине" />
                                <TextBox Classes="project-field"
                                         Text="{Binding RemoteDeploymentDirectory, Mode=TwoWay}"
                                         PlaceholderText="/opt/kk-var/billing-api" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Переменные окружения"
                                       FontSize="19"
                                       FontWeight="Bold" />
                            <TextBlock Text="Путь задаётся относительно корня проекта. Сам файл KK.Var сформирует при сборке."
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                            <TextBox Margin="0,8,0,0"
                                     Classes="project-field"
                                     Text="{Binding ProjectEnvironmentFilePath, Mode=TwoWay}"
                                     PlaceholderText="config/production.env.json" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="DiscardConfirmation"
                IsVisible="False"
                Background="#C9080510">
            <Border Width="460"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="Не сохранять изменения?"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="Введённые данные проекта будут потеряны."
                               FontSize="13"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <StackPanel Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Classes="project-secondary"
                                Content="Продолжить редактирование"
                                Click="ContinueEditingButton_OnClick" />
                        <Button Classes="project-primary"
                                Content="Не сохранять"
                                Click="DiscardButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
