<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KK.Var.ViewModels"
        xmlns:models="using:KK.Var.Models"
        xmlns:controls="using:KK.Var.Views.Controls"
        xmlns:pages="using:KK.Var.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        x:Class="KK.Var.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Brand/kk-var.ico"
        Width="1920"
        Height="1080"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        CanResize="True"
        Background="Transparent"
        Title="KK.Var">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <StreamGeometry x:Key="ProjectsIconData">M3,13H11V3H3V13 M3,21H11V15H3V21 M13,21H21V11H13V21 M13,3V9H21V3H13Z</StreamGeometry>
        <StreamGeometry x:Key="SettingsIconData">M3,17V19H9V17H3 M3,5V7H13V5H3 M13,21V19H21V17H13V15H11V21H13 M7,9V11H3V13H7V15H9V9H7 M21,13V11H11V13H21 M15,9H17V7H21V5H17V3H15V9Z</StreamGeometry>
        <StreamGeometry x:Key="HistoryIconData">M13,3C8,3 4,6.8 4,12H1L5,16L9,12H6C6,8 9.1,5 13,5C16.9,5 20,8.1 20,12C20,15.9 16.9,19 13,19C10.6,19 8.5,17.8 7.2,16L5.7,17.3C7.4,19.6 10,21 13,21C18,21 22,17 22,12C22,7 18,3 13,3 M12,7V13L17,16L18,14.4L14,12V7H12Z</StreamGeometry>
        <StreamGeometry x:Key="AddIconData">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
        <StreamGeometry x:Key="OpenIconData">M19,19H5V5H12V3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V12H19V19 M14,3V5H17.6L7.8,14.8L9.2,16.2L19,6.4V10H21V3H14Z</StreamGeometry>
        <StreamGeometry x:Key="EditIconData">M3,17.3V21H6.8L17.8,9.9L14.1,6.2L3,17.3 M20.7,7C21.1,6.6 21.1,6 20.7,5.6L18.4,3.3C18,2.9 17.4,2.9 17,3.3L15.1,5.1L18.9,8.9L20.7,7Z</StreamGeometry>
        <StreamGeometry x:Key="DeleteIconData">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4 M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="HelpIconData">M12,2C6.5,2 2,6.5 2,12C2,17.5 6.5,22 12,22C17.5,22 22,17.5 22,12C22,6.5 17.5,2 12,2 M13,19H11V17H13V19 M15.1,11.3L14.2,12.2C13.5,12.9 13,13.5 13,15H11V14.5C11,13.4 11.5,12.4 12.2,11.7L13.4,10.4C13.8,10.1 14,9.6 14,9C14,7.9 13.1,7 12,7C10.9,7 10,7.9 10,9H8C8,6.8 9.8,5 12,5C14.2,5 16,6.8 16,9C16,9.9 15.6,10.7 15.1,11.3Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Width" Value="140" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
            <Setter Property="Padding" Value="18,10" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="Button.deploy">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.window-control">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.window-control.close">
            <Setter Property="Background" Value="#E052A0" />
        </Style>
        <Style Selector="Button.window-control.minimize">
            <Setter Property="Background" Value="#7567E8" />
        </Style>
        <Style Selector="Button.window-control.maximize">
            <Setter Property="Background" Value="#38BDF8" />
        </Style>
        <Style Selector="Button.window-control.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F472B6" />
        </Style>
        <Style Selector="Button.window-control.minimize:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#968BFF" />
        </Style>
        <Style Selector="Button.window-control.maximize:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7DD3FC" />
        </Style>
    </Window.Styles>

    <Border x:Name="WindowFrame"
            Margin="8"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid RowDefinitions="46,*,38">
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    CornerRadius="14,14,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                        <controls:BrandMark Width="28" Height="28" />
                        <TextBlock Text="KK.Var"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource BrandFontFamily}"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="Transparent"
                            PointerPressed="TitleBar_OnPointerPressed" />

                    <StackPanel Grid.Column="2"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button Classes="window-control minimize"
                                Click="MinimizeButton_OnClick"
                                ToolTip.Tip="{DynamicResource 'Скрыть окно'}" />
                        <Button Classes="window-control maximize"
                                Click="MaximizeButton_OnClick"
                                ToolTip.Tip="{DynamicResource 'Развернуть или восстановить'}" />
                        <Button Classes="window-control close"
                                Click="CloseButton_OnClick"
                                ToolTip.Tip="{DynamicResource 'Закрыть'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="260,*">
                <Border Grid.Column="0"
                        Margin="0,0,1,0"
                        Padding="18"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,1,1,0">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Spacing="8">
                            <Grid>
                                <Button
                                        x:Name="ProjectsNavigationButton"
                                        Classes="nav active"
                                        Click="ProjectsNavigationButton_OnClick">
                                    <StackPanel Orientation="Horizontal" Spacing="11">
                                        <PathIcon Width="15"
                                                  Height="15"
                                                  Data="{StaticResource ProjectsIconData}" />
                                        <TextBlock Text="{DynamicResource 'Проекты'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button x:Name="HistoryNavigationButton"
                                    Classes="nav"
                                    Click="HistoryNavigationButton_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <PathIcon Width="15"
                                              Height="15"
                                              Data="{StaticResource HistoryIconData}" />
                                    <TextBlock Text="{DynamicResource 'История'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SettingsNavigationButton"
                                    Classes="nav"
                                    Click="SettingsNavigationButton_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <PathIcon Width="15"
                                              Height="15"
                                              Data="{StaticResource SettingsIconData}" />
                                    <TextBlock Text="{DynamicResource 'Настройки'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Border>

                <Grid x:Name="ProjectsPage"
                      Grid.Column="1"
                      RowDefinitions="Auto,*">
                    <Grid x:Name="ProjectsHeader"
                          Grid.Row="0"
                          Margin="30,26,30,18"
                          ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{DynamicResource 'Проекты'}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}" />
                            <TextBlock Text="{DynamicResource 'Сборка, доставка и управление локальными релизами'}"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="{DynamicResource '＋  Новый проект'}"
                                VerticalAlignment="Center"
                                Click="NewProjectButton_OnClick" />
                    </Grid>

                    <ScrollViewer x:Name="ProjectsList"
                                  Grid.Row="1"
                                  Margin="30,0,20,24"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProjectTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectTileViewModel">
                                    <Grid>
                                        <Border Width="354"
                                                Height="254"
                                                Margin="0,0,18,18"
                                                Padding="20"
                                                IsVisible="{Binding IsProject}"
                                                Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding Project.Name}"
                                                               FontSize="20"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="{Binding SourceDisplay}"
                                                               MaxWidth="310"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppTextMutedBrush}" />
                                                </StackPanel>

                                                <Border Grid.Row="1"
                                                        Height="1"
                                                        Margin="0,17"
                                                        Background="{DynamicResource AppBorderBrush}" />

                                                <Grid Grid.Row="2"
                                                      ColumnDefinitions="*,*"
                                                      RowDefinitions="Auto,Auto"
                                                      ColumnSpacing="12"
                                                      RowSpacing="13">
                                                    <StackPanel MinWidth="0" Spacing="3">
                                                        <TextBlock Text="{DynamicResource 'Последний deploy'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                                                        <TextBlock Text="{Binding LastDeploymentDisplay}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" MinWidth="0" Spacing="3">
                                                        <TextBlock Text="{DynamicResource 'Версия'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                                                        <TextBlock Text="{Binding LatestVersionTag}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1"
                                                                MinWidth="0"
                                                                Spacing="3">
                                                        <TextBlock Text="Systemd service"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                                                        <TextBlock Text="{Binding Project.RemoteServiceName}"
                                                                   MaxWidth="145"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Project.RemoteServiceName}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1"
                                                                Grid.Column="1"
                                                                MinWidth="0"
                                                                Spacing="3">
                                                        <TextBlock Text="Service file"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                                                        <TextBlock Text="{Binding Project.RemoteExecutablePath}"
                                                                   MaxWidth="145"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Project.RemoteExecutablePath}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="3"
                                                      Margin="0,16,0,0"
                                                      ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                      ColumnSpacing="8">
                                                    <Button Classes="deploy"
                                                            Content="Deploy"
                                                            Click="DeployProjectButton_OnClick" />
                                                    <Button Grid.Column="2"
                                                            Classes="icon"
                                                            ToolTip.Tip="{DynamicResource 'Открыть'}"
                                                            Click="OpenProjectButton_OnClick">
                                                        <PathIcon Width="18"
                                                                  Height="18"
                                                                  Foreground="{DynamicResource AppTextBrush}"
                                                                  Data="{StaticResource OpenIconData}" />
                                                    </Button>
                                                    <Button Grid.Column="3"
                                                            Classes="icon"
                                                            ToolTip.Tip="{DynamicResource 'Редактировать'}"
                                                            Click="EditProjectButton_OnClick">
                                                        <PathIcon Width="18"
                                                                  Height="18"
                                                                  Foreground="{DynamicResource AppTextBrush}"
                                                                  Data="{StaticResource EditIconData}" />
                                                    </Button>
                                                    <Button Grid.Column="4"
                                                            Classes="icon"
                                                            ToolTip.Tip="{DynamicResource 'Удалить'}"
                                                            Click="DeleteProjectButton_OnClick">
                                                        <PathIcon Width="18"
                                                                  Height="18"
                                                                  Foreground="{DynamicResource AppDangerBrush}"
                                                                  Data="{StaticResource DeleteIconData}" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Button Width="354"
                                                Height="254"
                                                Margin="0,0,18,18"
                                                Padding="0"
                                                IsVisible="{Binding IsAddTile}"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1"
                                                Background="Transparent"
                                                CornerRadius="14"
                                                Click="NewProjectButton_OnClick">
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="10">
                                                <PathIcon Width="32"
                                                          Height="32"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{DynamicResource AppPrimaryHoverBrush}"
                                                          Data="{StaticResource AddIconData}" />
                                                <TextBlock Text="{DynamicResource 'Добавить проект'}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border x:Name="ProjectsAccessBackdrop"
                            Grid.RowSpan="2"
                            IsVisible="False"
                            Background="#D9080510">
                        <Border MaxWidth="480"
                                Padding="34,30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <StackPanel Spacing="13">
                                <TextBlock Text="{DynamicResource 'Сначала настройте SSH-доступ'}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="22"
                                           FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource 'Для создания и развёртывания проектов KK.Var должен знать, к какой Linux-машине подключаться.'}"
                                           MaxWidth="400"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           LineHeight="20"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                                <Button Classes="primary"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Content="{DynamicResource 'Открыть настройки'}"
                                        Click="OpenRequiredSettingsButton_OnClick" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <pages:CreateProjectView x:Name="CreateProjectPage"
                                         Grid.Column="1"
                                         IsVisible="False"
                                         DataContext="{Binding ProjectEditor}" />

                <pages:ProjectDetailsView x:Name="ProjectDetailsPage"
                                          Grid.Column="1"
                                          IsVisible="False"
                                          DataContext="{Binding}" />

                <pages:HistoryView x:Name="HistoryPage"
                                   Grid.Column="1"
                                   IsVisible="False" />

                <pages:SettingsView x:Name="SettingsPage"
                                    Grid.Column="1"
                                    IsVisible="False" />
            </Grid>

            <Border x:Name="StatusBar"
                    Grid.Row="2"
                    Padding="14,0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                    <ProgressBar Grid.Column="0"
                                 Width="150"
                                 Height="4"
                                 IsVisible="{Binding IsOperationRunning}"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding OperationStatusText}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextMutedBrush}" />

                    <Border Grid.Column="2"
                            Width="1"
                            Height="16"
                            IsVisible="{Binding HasNotification}"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppBorderBrush}" />

                    <TextBlock Grid.Column="3"
                               IsVisible="{Binding HasErrorNotification}"
                               Text="{Binding NotificationMessage}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Foreground="{DynamicResource AppDangerBrush}" />

                    <TextBlock Grid.Column="3"
                               IsVisible="{Binding HasSuccessNotification}"
                               Text="{Binding NotificationMessage}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Foreground="{DynamicResource AppSuccessBrush}" />

                    <Button Grid.Column="4"
                            Width="36"
                            Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{Binding LanguageButtonText}"
                            ToolTip.Tip="{Binding LanguageButtonToolTip}"
                            Click="LanguageButton_OnClick" />

                    <Button Grid.Column="5"
                            Width="28"
                            Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="HelpButton_OnClick"
                            ToolTip.Tip="{DynamicResource 'Помощь'}">
                        <PathIcon Width="17"
                                  Height="17"
                                  Foreground="{DynamicResource AppTextBrush}"
                                  Data="{StaticResource HelpIconData}" />
                    </Button>
                </Grid>
            </Border>
            </Grid>

            <Border x:Name="ModalBackdrop"
                    IsVisible="False"
                    Background="#A6000000"
                    CornerRadius="14" />

            <Border x:Name="DeleteProjectConfirmation"
                    IsVisible="False"
                    Background="#C9080510"
                    CornerRadius="14">
                <Border Width="460"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource 'Удалить проект?'}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="DeleteProjectMessage"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock Text="{DynamicResource 'Версии, переменные окружения, история deploy и локальные архивы также будут удалены.'}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppDangerBrush}" />
                        <StackPanel Margin="0,10,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="10">
                            <Button Classes="primary"
                                    Background="{DynamicResource AppSurfaceRaisedBrush}"
                                    Content="{DynamicResource 'Отмена'}"
                                    Click="CancelDeleteProjectButton_OnClick" />
                            <Button Classes="primary"
                                    Background="{DynamicResource AppDangerBrush}"
                                    Content="{DynamicResource 'Удалить'}"
                                    Click="ConfirmDeleteProjectButton_OnClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>

</Window>
