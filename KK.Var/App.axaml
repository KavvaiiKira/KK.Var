<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KK.Var.App"
             xmlns:local="using:KK.Var"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AppBackgroundColor">#0C0814</Color>
            <Color x:Key="AppSurfaceColor">#151022</Color>
            <Color x:Key="AppSurfaceRaisedColor">#1D1530</Color>
            <Color x:Key="AppSurfaceHoverColor">#281C40</Color>
            <Color x:Key="AppBorderColor">#3B2B5A</Color>
            <Color x:Key="AppPrimaryColor">#8B5CF6</Color>
            <Color x:Key="AppPrimaryHoverColor">#A78BFA</Color>
            <Color x:Key="AppAccentColor">#C084FC</Color>
            <Color x:Key="AppTextColor">#F4F0FF</Color>
            <Color x:Key="AppTextMutedColor">#A99EBE</Color>
            <Color x:Key="AppSuccessColor">#4ADE80</Color>
            <Color x:Key="AppDangerColor">#FB7185</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="{StaticResource AppSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="{StaticResource AppPrimaryColor}" />
            <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMutedColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />

            <!-- KK form control states override the Fluent system colors. -->
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource AppSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource AppSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource AppSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AppPrimaryColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AppPrimaryColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AppPrimaryColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource AppPrimaryColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource AppSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource AppSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource AppSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="{StaticResource AppSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="{StaticResource AppBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="{StaticResource AppPrimaryHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource AppSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="{StaticResource AppPrimaryHoverColor}" />

            <FontFamily x:Key="BrandFontFamily">avares://KK.Var/Assets/Fonts#Exo 2</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#8B5CF6" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <Style Selector=":is(Window)">
            <Setter Property="Icon" Value="avares://KK.Var/Assets/Brand/kk-var.ico" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox /template/ Popup#PART_Popup">
            <Setter Property="VerticalOffset" Value="6" />
            <Setter Property="WindowManagerAddShadowHint" Value="True" />
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="ComboBox[IsDropDownOpen=True] /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
