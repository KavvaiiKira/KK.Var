<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KK.Var.ViewModels"
             xmlns:models="using:KK.Var.Models"
             xmlns:controls="using:KK.Var.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="800"
             x:Class="KK.Var.Views.Pages.ProjectDetailsView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="ToggleButton.preflight-detail">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="ToggleButton.preflight-detail:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.preflight-detail:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.preflight-detail:checked PathIcon">
            <Setter Property="RenderTransform">
                <RotateTransform Angle="90" />
            </Setter>
        </Style>
        <Style Selector="TextBox.deploy-input">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.details-secondary">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.details-tab">
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="Button.details-tab.active">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryHoverBrush}" />
        </Style>
        <Style Selector="TextBlock.details-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.details-value">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox.environment-input">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox.environment-input">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Margin="30,24,30,14" ColumnDefinitions="Auto,*,Auto">
            <Button Width="42" Height="42" Margin="0,0,14,0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Classes="details-secondary" Click="BackButton_OnClick" ToolTip.Tip="{DynamicResource 'Назад к проектам'}">
                <PathIcon Width="19" Height="19"
                          Data="M20,11H7.8L13.4,5.4L12,4L4,12L12,20L13.4,18.6L7.8,13H20V11Z" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{Binding SelectedProject.Name}" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedProject.EffectiveDescription}" FontSize="13"
                           Foreground="{DynamicResource AppTextMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Button Classes="deploy"
                        Padding="16,10"
                        Content="{DynamicResource 'Развернуть'}"
                        Click="DeployButton_OnClick" />
                <Button Classes="details-secondary" Content="{DynamicResource 'Редактировать'}" Click="EditButton_OnClick" />
                <Button Classes="details-secondary" Content="{DynamicResource 'Экспорт'}"
                        ToolTip.Tip="{DynamicResource 'Экспорт включает значения переменных проекта и процесса сборки.'}"
                        IsEnabled="{Binding CanExportProjectConfiguration}" Click="ExportProjectButton_OnClick" />
                <Button Classes="details-secondary" Foreground="{DynamicResource AppDangerBrush}"
                        Content="{DynamicResource 'Удалить'}" Click="DeleteButton_OnClick" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="30,0,30,16" Orientation="Horizontal" Spacing="6">
            <Button x:Name="OverviewTab" Classes="details-tab active" Content="{DynamicResource 'Обзор'}" Click="OverviewTab_OnClick" />
            <Button x:Name="EnvironmentTab" Classes="details-tab" Content="{DynamicResource 'Переменные'}" Click="EnvironmentTab_OnClick" />
            <Button x:Name="VersionsTab" Classes="details-tab" Content="{DynamicResource 'Версии'}" Click="VersionsTab_OnClick" />
            <Button x:Name="ProjectHistoryTab" Classes="details-tab" Content="{DynamicResource 'История'}" Click="ProjectHistoryTab_OnClick" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="30,0,20,24" HorizontalContentAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1050" HorizontalAlignment="Stretch">
                <StackPanel x:Name="OverviewPanel" Spacing="18">
                    <Border Padding="24" Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20">
                            <StackPanel>
                                <TextBlock Classes="details-label" Text="{DynamicResource 'Источник'}" />
                                <TextBlock Classes="details-value" Text="{Binding SelectedProjectSourceDisplay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="details-label" Text="{DynamicResource 'Тип сборки'}" />
                                <TextBlock Classes="details-value" Text="{Binding SelectedProject.BuildProvider}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Classes="details-label" Text="{DynamicResource 'Последний deploy'}" />
                                <TextBlock Classes="details-value" Text="{Binding SelectedProjectLastDeploymentDisplay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Classes="details-label" Text="{DynamicResource 'Версия'}" />
                                <TextBlock Classes="details-value" Foreground="{DynamicResource AppPrimaryHoverBrush}"
                                           Text="{Binding SelectedProjectLatestVersionTag}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="24" Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20">
                            <StackPanel>
                                <TextBlock Classes="details-label" Text="{DynamicResource 'Systemd-сервис'}" />
                                <TextBlock Classes="details-value" FontFamily="Consolas"
                                           Text="{Binding SelectedProject.RemoteServiceName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="details-label" Text="{DynamicResource 'Файл сервиса'}" />
                                <TextBlock Classes="details-value" FontFamily="Consolas"
                                           Text="{Binding SelectedProject.RemoteExecutablePath}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                <TextBlock Classes="details-label" Text="{DynamicResource 'Файл переменных окружения'}" />
                                <TextBlock Classes="details-value" FontFamily="Consolas"
                                           Text="{Binding SelectedProject.ProjectEnvironmentFilePath}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="EnvironmentPanel" IsVisible="False" Spacing="14">
                    <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{DynamicResource 'Переменные окружения'}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource 'Во время deploy они будут записаны в выбранном формате по пути, указанному в проекте.'}"
                                       FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Classes="environment-input"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding EnvironmentEditor.EnvironmentFileFormats}"
                                  SelectedItem="{Binding EnvironmentEditor.SelectedEnvironmentFileFormat}" />
                        <Button Grid.Column="2" Classes="details-secondary" Content="{DynamicResource '＋ Добавить'}"
                                Click="AddVariableButton_OnClick" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding EnvironmentEditor.EnvironmentVariables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnvironmentVariableRowViewModel">
                                <Grid Margin="0,0,0,9" ColumnDefinitions="280,*,42" ColumnSpacing="10">
                                    <TextBox Classes="environment-input"
                                             PlaceholderText="{DynamicResource 'ИМЯ_ПЕРЕМЕННОЙ'}"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1"
                                             Classes="environment-input"
                                             PlaceholderText="{DynamicResource 'Значение'}"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Width="42" Classes="details-secondary" Content="×"
                                            Foreground="{DynamicResource AppDangerBrush}"
                                            Click="RemoveVariableButton_OnClick" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Button Classes="deploy"
                                HorizontalAlignment="Left"
                                Content="{DynamicResource 'Сохранить сейчас'}"
                                Click="SaveVariablesButton_OnClick" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding EnvironmentEditor.EnvironmentSaveStatus}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="VersionsPanel" IsVisible="False" Spacing="14">
                    <TextBlock Text="{DynamicResource 'Версии'}" FontSize="20" FontWeight="Bold" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="{DynamicResource 'Версия создаётся автоматически после успешной сборки. Архив и контрольная сумма неизменяемы.'}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock Text="{DynamicResource 'Закрепление защищает версию от автоматической очистки. «Открепить» снимает защиту, но не удаляет версию. Версия на сервере не меняется.'}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Foreground="{DynamicResource AppTextMutedBrush}">
                            <Run Text="{DynamicResource 'Общий размер проекта'}" />
                            <Run Text=": " />
                            <Run Text="{Binding ProjectDetails.ProjectArtifactsSizeDisplay}" />
                        </TextBlock>
                        <TextBlock IsVisible="{Binding ProjectDetails.HasMissingProjectArtifacts}"
                                   Text="{Binding ProjectDetails.MissingProjectArtifactsDisplay}"
                                   Foreground="{DynamicResource AppDangerBrush}" />
                    </StackPanel>
                    <Button Classes="details-secondary"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding !ProjectDetails.IsVersionCleanupBusy}"
                            Content="{DynamicResource 'Очистить версии'}"
                            Click="PrepareVersionCleanupButton_OnClick" />
                    <TextBlock IsVisible="{Binding ProjectDetails.HasNoProjectVersions}" Margin="0,36,0,0"
                               HorizontalAlignment="Center" Text="{DynamicResource 'У проекта пока нет собранных версий'}"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding ProjectDetails.ProjectVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectVersionItemViewModel">
                                <Border Margin="0,0,0,10" Padding="18" Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <Grid ColumnDefinitions="160,135,105,*,Auto,Auto,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Tag}" FontWeight="Bold"
                                                       Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                                            <TextBlock Text="{Binding TargetArchitecture}" FontSize="11"
                                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                                            <TextBlock Text="{Binding SourceCommitDisplay}"
                                                       IsVisible="{Binding HasSourceCommit}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                                       ToolTip.Tip="{Binding Version.SourceCommitSha}" />
                                            <TextBlock Text="{Binding AvailabilityDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                                            <TextBlock IsVisible="{Binding IsPinned}"
                                                       Text="{Binding PinnedDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                                            <TextBlock IsVisible="{Binding IsProtected}"
                                                       Text="{Binding ProtectedDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ArtifactSizeDisplay}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="4" Classes="details-secondary"
                                                Padding="12,8"
                                                Content="{Binding PinActionText}"
                                                Click="PinVersionButton_OnClick" />
                                        <Button Grid.Column="5" Classes="details-secondary"
                                                Padding="12,8" Content="{DynamicResource 'Откатить'}"
                                                IsEnabled="{Binding ArtifactExists}"
                                                Click="RollbackButton_OnClick" />
                                        <Button Grid.Column="6" Classes="details-secondary"
                                                Padding="12,8"
                                                IsEnabled="{Binding CanDelete}"
                                                Foreground="{DynamicResource AppDangerBrush}"
                                                Content="{DynamicResource 'Удалить'}"
                                                Click="DeleteVersionButton_OnClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="HistoryPanel" IsVisible="False" Spacing="14">
                    <TextBlock Text="{DynamicResource 'История проекта'}" FontSize="20" FontWeight="Bold" />
                    <TextBlock IsVisible="{Binding ProjectDetails.HasNoProjectHistory}" Margin="0,36,0,0"
                               HorizontalAlignment="Center" Text="{DynamicResource 'Deploy и rollback ещё не выполнялись'}"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding ProjectDetails.ProjectHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeploymentHistoryItemViewModel">
                                <Border Margin="0,0,0,10" Padding="18" Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10"
                                        Cursor="Hand" PointerPressed="DeploymentItem_OnPointerPressed">
                                    <Grid ColumnDefinitions="170,170,150,*" ColumnSpacing="18">
                                        <TextBlock Text="{Binding DateDisplay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding VersionTag}"
                                                   Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding OperationDisplay}" />
                                        <TextBlock Grid.Column="3" Text="{Binding StatusDisplay}" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button IsVisible="{Binding ProjectDetails.HasMoreProjectHistoryItems}"
                            Padding="18,9"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AppSurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Content="{DynamicResource 'Показать ещё'}"
                            Click="LoadMoreProjectHistoryButton_OnClick" />
                </StackPanel>

                <Border x:Name="DeployPanel" IsVisible="False" Padding="26"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppPrimaryBrush}" BorderThickness="1" CornerRadius="14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource 'Deploy проекта'}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource 'KK.Var соберёт исходный код, создаст локальную версию, передаст файлы на Linux-машину и перезапустит systemd-сервис.'}"
                                   MaxWidth="680" HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                        <Border Padding="16"
                                Background="{DynamicResource AppSurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource 'Исходный код'}"
                                           FontWeight="SemiBold" />
                                <SelectableTextBlock Text="{Binding SelectedProjectSourceDisplay}"
                                                     TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource 'Источник задан в настройках проекта.'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border IsVisible="{Binding IsSelectedProjectGitHub}"
                                Padding="18"
                                Background="{DynamicResource AppSurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel VerticalAlignment="Center" Spacing="5">
                                        <TextBlock Text="{DynamicResource 'Ветка проекта GitHub'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                                        <TextBlock Text="{Binding DeploymentGitHubSource.SelectedBranch.Label}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            IsEnabled="{Binding !DeploymentWorkspace.IsSelectedProjectDeploymentActive}"
                                            Classes="details-secondary"
                                            VerticalAlignment="Center"
                                            Content="{DynamicResource 'Обновить коммит'}"
                                            Click="DeploymentCommit_OnClick" />
                                </Grid>
                                <TextBlock IsVisible="{Binding DeploymentGitHubSource.IsResolving}"
                                           Text="{DynamicResource 'Загрузка коммита…'}"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                                <TextBlock IsVisible="{Binding DeploymentGitHubSource.HasError}"
                                           Text="{Binding DeploymentGitHubSource.ErrorMessage}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppDangerBrush}" />
                                <Border IsVisible="{Binding DeploymentGitHubSource.HasCommit}"
                                        Height="1"
                                        Background="{DynamicResource AppBorderBrush}" />
                                <controls:GitHubCommitCard Classes="embedded"
                                                           DataContext="{Binding DeploymentGitHubSource}" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,12,0,0" ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource 'Следующая версия'}" Foreground="{DynamicResource AppTextMutedBrush}" />
                            <TextBox x:Name="DeploymentTagInput" Classes="deploy-input" Grid.Column="1" PlaceholderText="{DynamicResource 'Например, release-1'}"
                                     IsReadOnly="{Binding DeploymentWorkspace.IsSelectedProjectDeploymentActive}"
                                     Text="{Binding DeploymentVersionTag}" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{DynamicResource 'Описание'}" Foreground="{DynamicResource AppTextMutedBrush}" />
                            <TextBox Classes="deploy-input" Grid.Row="1" Grid.Column="1" PlaceholderText="{DynamicResource 'Что изменилось в этой версии'}"
                                     IsReadOnly="{Binding DeploymentWorkspace.IsSelectedProjectDeploymentActive}"
                                     Text="{Binding DeploymentDescription}" />
                        </Grid>
                        <Grid IsVisible="{Binding DeploymentWorkspace.IsSelectedProjectDeploymentActive}"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding DeploymentWorkspace.SelectedProjectQueueStatusText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                            <Button Grid.Column="1"
                                    Classes="details-secondary"
                                    Padding="12,7"
                                    IsVisible="{Binding DeploymentWorkspace.IsSelectedProjectDeploymentWaiting}"
                                    Content="{DynamicResource 'Отменить операцию'}"
                                    Click="CancelDeploymentButton_OnClick" />
                        </Grid>
                        <ProgressBar Height="4" Minimum="0" Maximum="100"
                                     IsVisible="{Binding DeploymentWorkspace.IsSelectedProjectDeploymentRunning}"
                                     Value="{Binding DeploymentWorkspace.DeploymentProgressPercentage}" />
                        <TextBlock IsVisible="{Binding IsPreflightChecking}"
                                   Text="{DynamicResource 'Выполняется предварительная проверка…'}"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                        <Border IsVisible="{Binding DeploymentWorkspace.HasDeploymentPreflightResult}"
                                Padding="12"
                                Background="{DynamicResource AppSurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Expander x:Name="PreflightExpander"
                                      IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <Expander.Header>
                                    <TextBlock Text="{Binding DeploymentWorkspace.DeploymentPreflightSummary}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextMutedBrush}" />
                                </Expander.Header>
                                <ScrollViewer IsVisible="{Binding !!DeploymentWorkspace.DeploymentPreflightItems.Count}"
                                              MaxHeight="260"
                                              AllowAutoHide="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PreflightResults"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding DeploymentWorkspace.DeploymentPreflightItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeploymentPreflightItemViewModel">
                                            <Grid ColumnDefinitions="130,*" ColumnSpacing="12" Margin="0,4" Focusable="True">
                                                <TextBlock IsVisible="{Binding IsSuccess}"
                                                           Text="{DynamicResource 'Успешно'}"
                                                           Foreground="{DynamicResource AppSuccessBrush}" />
                                                <TextBlock IsVisible="{Binding IsWarning}"
                                                           Text="{DynamicResource 'Предупреждение'}"
                                                           Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                                                <TextBlock IsVisible="{Binding IsError}"
                                                           Text="{DynamicResource 'Ошибка'}"
                                                           Foreground="{DynamicResource AppDangerBrush}" />
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                    <StackPanel IsVisible="{Binding HasDetail}" Spacing="6">
                                                        <ToggleButton Classes="preflight-detail"
                                                                      IsChecked="{Binding IsDetailExpanded, Mode=TwoWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <PathIcon Width="10" Height="10"
                                                                          Data="M3,1 L8,6 L3,11 Z"
                                                                          RenderTransformOrigin="50%,50%"
                                                                          Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                                                                <TextBlock Text="{DynamicResource 'Технические подробности'}" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <Border IsVisible="{Binding IsDetailExpanded}"
                                                                Padding="12"
                                                                Background="{DynamicResource AppBackgroundBrush}"
                                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                            <SelectableTextBlock Text="{Binding Detail}"
                                                                                 FontFamily="Cascadia Mono, Consolas"
                                                                                 TextWrapping="Wrap"
                                                                                 FontSize="12" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>
                        </Border>
                        <Border IsVisible="{Binding DeploymentWorkspace.HasVisibleDeploymentLog}"
                                Height="210" Padding="12"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="DeploymentLog"
                                     Text="{Binding DeploymentWorkspace.VisibleDeploymentLogText}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     TextChanged="DeploymentLog_OnTextChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <WrapPanel Margin="0,12,0,0" ItemSpacing="12" LineSpacing="8">
                            <Button Classes="details-secondary"
                                    IsEnabled="{Binding CanCheckDeployment}"
                                    Content="{DynamicResource 'Проверить'}"
                                    Click="CheckDeploymentButton_OnClick" />
                            <Button Classes="deploy"
                                    IsEnabled="{Binding CanCheckDeployment}"
                                    Content="{DynamicResource 'Собрать и выполнить deploy'}"
                                    Click="RunDeployButton_OnClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border x:Name="UnsavedEnvironmentConfirmation"
                Grid.RowSpan="3"
                IsVisible="False"
                Background="#C9080510">
            <Border Width="500"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource 'Переменные ещё не сохранены'}"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource 'Автосохранение не завершилось или в списке есть незаполненная переменная.'}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <StackPanel Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Classes="details-secondary"
                                Content="{DynamicResource 'Остаться'}"
                                Click="StayOnEnvironmentButton_OnClick" />
                        <Button Classes="details-secondary"
                                Foreground="{DynamicResource AppDangerBrush}"
                                Content="{DynamicResource 'Уйти без сохранения'}"
                                Click="DiscardEnvironmentButton_OnClick" />
                        <Button Classes="deploy"
                                Padding="16,10"
                                Content="{DynamicResource 'Сохранить и перейти'}"
                                Click="SaveEnvironmentAndContinueButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding ProjectDetails.HasPendingVersionCleanup}"
                Grid.RowSpan="3"
                Background="#C9080510">
            <Border Width="500"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource 'Очистить версии?'}"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding ProjectDetails.VersionCleanupPreview}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <StackPanel Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Classes="details-secondary"
                                Content="{DynamicResource 'Отмена'}"
                                Click="CancelVersionCleanupButton_OnClick" />
                        <Button Classes="details-secondary"
                                Foreground="{DynamicResource AppDangerBrush}"
                                Content="{DynamicResource 'Очистить версии'}"
                                Click="ConfirmVersionCleanupButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="DeleteVersionConfirmation"
                Grid.RowSpan="3"
                IsVisible="False"
                Background="#C9080510">
            <Border Width="500"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource 'Удалить локальную версию?'}"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock x:Name="DeleteVersionMessage"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextMutedBrush}" />
                    <StackPanel Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Classes="details-secondary"
                                Content="{DynamicResource 'Отмена'}"
                                Click="CancelDeleteVersionButton_OnClick" />
                        <Button Classes="details-secondary"
                                Foreground="{DynamicResource AppDangerBrush}"
                                Content="{DynamicResource 'Удалить'}"
                                Click="ConfirmDeleteVersionButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
